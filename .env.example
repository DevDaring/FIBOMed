# FIBOMed Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================
# Google Cloud API Keys
# ============================================
# Gemini API Key (Get from Google AI Studio: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud credentials file path (for Speech-to-Text and Text-to-Speech)
# Download from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Place the JSON file in a secure location and provide the path here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json

# ============================================
# Server Configuration
# ============================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Secret keys for JWT authentication (generate random strings)
SECRET_KEY=your_secret_key_here_change_this_in_production
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# ============================================
# File Storage Paths
# ============================================
CSV_DATA_PATH=./data/csv_files
UPLOAD_PATH=./data/uploads
GENERATED_PATH=./data/generated

# ============================================
# Feature Flags
# ============================================
ENABLE_VOICE_CHAT=true
MAX_UPLOAD_SIZE=104857600

# ============================================
# CORS Settings (comma-separated origins)
# ============================================
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ============================================
# Google Cloud Speech Settings
# ============================================
GOOGLE_SPEECH_LANGUAGE_CODE=en-US
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-F

# ============================================
# Gemini Settings
# ============================================
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
