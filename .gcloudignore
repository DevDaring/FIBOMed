# Google Cloud Ignore File for Cloud Run Deployment

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Secrets - CRITICAL: Never deploy secrets to Cloud Run
# Use Secret Manager or environment variables instead
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
ENV/
env/
.venv/

# Node
frontend/node_modules/
frontend/.npm
frontend/.yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
frontend/dist/

# Documentation (except README)
FIBO_Med.md
FIBO_Use.md
FIBO_Usage.py
Full_Project_Plan.md
IMPLEMENTATION_SUMMARY.md

# Kiro specs
.kiro/

# Test files
**/tests/
**/*.test.ts
**/*.test.tsx
**/*.test.py

# Local development files
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Local run scripts
run.bat
run.sh

# Generated data (will be created at runtime in Cloud Run)
data/generated/
data/uploads/reports/*.txt
data/uploads/prescriptions/*.txt
data/backups/
